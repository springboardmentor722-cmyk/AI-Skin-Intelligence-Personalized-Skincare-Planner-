# Relational database (defaults to SQLite for local dev; use PostgreSQL in production)
DATABASE_URL=sqlite:///./lumen.db
# DATABASE_URL=postgresql+psycopg2://lumen:lumen@localhost:5432/lumen

# MongoDB (optional in Milestone 1 - reserved for AI scan images / unstructured data)
MONGO_URL=
MONGO_DB=lumen

# Auth
JWT_SECRET=change-me-in-production-please
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# Google Sign-In (optional).
# Create an OAuth 2.0 Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials
# Add http://localhost:5173 under "Authorized JavaScript origins", then paste the ID here.
# Leave blank to disable the Continue with Google button entirely.
GOOGLE_CLIENT_ID=

# --- AI skin analysis (Milestone 3, Parts 4-8) ---
# Directory holding trained ONNX models (skin_type.onnx, skin_concern.onnx).
# If empty/absent, the app uses the built-in feature model automatically.
AI_MODEL_DIR=
UPLOAD_DIR=
AI_MAX_UPLOAD_MB=8
AI_FACE_REQUIRED=true

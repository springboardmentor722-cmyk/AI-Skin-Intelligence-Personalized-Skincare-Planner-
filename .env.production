# Skinlytics — production template.
# Every value here is a placeholder. Real production values are injected by the
# deployment platform's secret manager (never committed, never filled in here).

# ─── App ──────────────────────────────────────────────────────────────────
ENVIRONMENT=production
NEXT_PUBLIC_APP_URL=https://app.skinlytics.example
NEXT_PUBLIC_API_URL=https://api.skinlytics.example

# ─── Identity — Better Auth ─────────────────────────────────────────────────
BETTER_AUTH_SECRET=          # inject via secret manager
BETTER_AUTH_URL=https://app.skinlytics.example
GOOGLE_CLIENT_ID=            # inject via secret manager
GOOGLE_CLIENT_SECRET=        # inject via secret manager

# ─── Postgres ────────────────────────────────────────────────────────────────
DATABASE_URL=                # inject via secret manager (managed Postgres, TLS required)

# ─── Backend JWT verification ───────────────────────────────────────────────
JWT_ISSUER=https://app.skinlytics.example
JWT_AUDIENCE=https://app.skinlytics.example

# ─── MongoDB ─────────────────────────────────────────────────────────────────
MONGO_URI=                   # inject via secret manager (managed Mongo, TLS required)

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=                   # inject via secret manager (managed Redis, TLS required)

# ─── Elasticsearch ────────────────────────────────────────────────────────────
ELASTICSEARCH_URL=           # inject via secret manager (security enabled, TLS required)

# ─── Vector DB — Pinecone in production ────────────────────────────────────
VECTOR_DB_PROVIDER=pinecone
PINECONE_API_KEY=            # inject via secret manager
PINECONE_ENVIRONMENT=
PINECONE_INDEX=skinlytics-prod

# ─── Object storage — S3 / Azure Blob ───────────────────────────────────────
S3_ENDPOINT_URL=              # leave blank for AWS S3; set for Azure Blob/S3-compatible
S3_ACCESS_KEY_ID=            # inject via secret manager
S3_SECRET_ACCESS_KEY=        # inject via secret manager
S3_BUCKET_NAME=skinlytics-storage
S3_REGION=us-east-1

# ─── Payments — live keys, injected only, verify webhook signatures ────────
STRIPE_SECRET_KEY=           # inject via secret manager
STRIPE_WEBHOOK_SECRET=       # inject via secret manager
RAZORPAY_KEY_ID=             # inject via secret manager
RAZORPAY_KEY_SECRET=         # inject via secret manager

# ─── Observability ───────────────────────────────────────────────────────────
SENTRY_DSN=                  # inject via secret manager

# ─── External data sources ───────────────────────────────────────────────────
KAGGLE_USERNAME=
KAGGLE_KEY=                  # inject via secret manager
OPENWEATHER_API_KEY=         # inject via secret manager
OPENUV_API_KEY=              # inject via secret manager
NCBI_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

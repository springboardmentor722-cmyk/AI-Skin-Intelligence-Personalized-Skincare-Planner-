# Skinlytics — development defaults.
# Non-secret values are pre-filled to match docker-compose.yml. Secret fields are
# left blank on purpose (never hardcode secrets, even for local dev) — generate/obtain
# them per the comment in .env.example and put the real values in a gitignored `.env`.

# ─── App ──────────────────────────────────────────────────────────────────
ENVIRONMENT=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── Identity — Better Auth ─────────────────────────────────────────────────
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Postgres (docker-compose: postgres, user/pass/db = skinlytics) ────────
DATABASE_URL=postgresql://skinlytics:skinlytics@localhost:5432/skinlytics

# ─── Backend JWT verification ───────────────────────────────────────────────
JWT_ISSUER=http://localhost:3000
JWT_AUDIENCE=http://localhost:3000

# ─── MongoDB (docker-compose: mongo, no auth in dev) ────────────────────────
MONGO_URI=mongodb://localhost:27017/skinlytics

# ─── Redis (docker-compose: redis) ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Elasticsearch (docker-compose: elasticsearch, security disabled in dev) ─
ELASTICSEARCH_URL=http://localhost:9200

# ─── Vector DB — FAISS in-process, no service to configure in dev ──────────
VECTOR_DB_PROVIDER=faiss
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX=
FAISS_INDEX_DIR=../ml/faiss

# ─── AI interfaces (ADR-007) — stub|real per interface ─────────────────────
AI_IMPL_EMBEDDER=stub

# ─── Object storage — MinIO (docker-compose: minio; MINIO_ROOT_USER/PASSWORD
# above) — MinIO generates its own, not a third-party account, so a real value
# ships here unlike every other blank secret in this file. Never use these
# outside local dev.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=skinlytics
S3_SECRET_ACCESS_KEY=skinlytics_dev_only
S3_BUCKET_NAME=skinlytics-storage
S3_REGION=us-east-1

# ─── Payments — sandbox/test keys only, never live keys in dev ─────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─── Observability — leave blank to skip Sentry locally ─────────────────────
SENTRY_DSN=

# ─── External data sources ───────────────────────────────────────────────────
KAGGLE_USERNAME=
KAGGLE_KEY=
OPENWEATHER_API_KEY=
OPENUV_API_KEY=
NCBI_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

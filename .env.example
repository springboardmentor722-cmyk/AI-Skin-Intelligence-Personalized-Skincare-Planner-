# Skinlytics — environment variable template.
# Copy to `.env` for local overrides (gitignored). Never put real secrets in
# .env.example / .env.development / .env.production — those are committed templates.
# Source of truth for what reads each var: docs/ARCHITECTURE.md §6-8,
# database_schemas/skinlytics_identity_betterauth.md, docs/DATASETS_AND_APIS.md.

# ─── App ──────────────────────────────────────────────────────────────────
# development | production
ENVIRONMENT=development
# Base URL the Next.js app is served from (web/).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Base URL the frontend's typed client (web/lib/api.ts) calls (backend/).
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── Identity — Better Auth (web/lib/auth.ts) — ADR-002/003 ────────────────
# Signing secret for Better Auth sessions/cookies. Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
# Must match NEXT_PUBLIC_APP_URL — Better Auth mounts its handler on the web app.
BETTER_AUTH_URL=http://localhost:3000
# OAuth2 social login (optional in M1; leave blank to disable a provider).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Postgres — system of record (Better Auth tables + domain tables) ──────
# Used by both `web` (Better Auth) and `backend` (SQLAlchemy) — same database.
DATABASE_URL=postgresql://skinlytics:skinlytics@localhost:5432/skinlytics

# ─── Backend (FastAPI) — JWT verification, core/config.py ──────────────────
# Both default to BETTER_AUTH_URL per the identity doc; override only if the
# issuer/audience is intentionally different from the auth server's own URL.
JWT_ISSUER=http://localhost:3000
JWT_AUDIENCE=http://localhost:3000

# ─── MongoDB — lifestyle logs, assessments, progress, preferences, weather ──
MONGO_URI=mongodb://localhost:27017/skinlytics

# ─── Redis — sessions, rate limits, caches, arq queues ──────────────────────
REDIS_URL=redis://localhost:6379/0
# Requests/minute per identity (JWT sub, else client IP) before the gateway returns
# 429 — app/core/rate_limit.py. Optional; defaults to 300 if unset.
RATE_LIMIT_PER_MINUTE=300

# ─── Elasticsearch — derived search index (products/ingredients/articles) ───
ELASTICSEARCH_URL=http://localhost:9200

# ─── Vector DB — dev: FAISS (in-process, no service); prod: Pinecone ───────
VECTOR_DB_PROVIDER=faiss
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX=

# ─── Object storage — S3-compatible (MinIO in docker-compose.yml locally, real ────
# S3/Azure Blob in prod). Bucket layout: skinlytics_infrastructure_layer_v2.txt §2.
# The dev credentials below are non-secret local-only conveniences (same class as
# DATABASE_URL's postgres/postgres above) — MinIO generates its own, not a
# third-party account, so a real value ships here unlike every other blank secret
# in this file. Never use these outside local dev.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=skinlytics
S3_SECRET_ACCESS_KEY=skinlytics_dev_only
S3_BUCKET_NAME=skinlytics-storage
S3_REGION=us-east-1

# ─── Payments — Stripe/Razorpay, dual currency (₹ primary, $ secondary) ────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─── Observability ───────────────────────────────────────────────────────
SENTRY_DSN=

# ─── External data sources — docs/DATASETS_AND_APIS.md ─────────────────────
KAGGLE_USERNAME=
KAGGLE_KEY=
OPENWEATHER_API_KEY=
OPENUV_API_KEY=
NCBI_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
# ISIC public API, OpenAlex, and Crossref need no key.

# --- Secrets (real env files are never committed; .env.example/.development/.production are templates only) ---
.env
.env.local
.env.*.local

# --- Node / Next.js (web/) ---
node_modules/
.next/
out/
web/.next/
web/out/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Python / FastAPI (backend/, ml/) ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
/dist/
/build/

# --- Databases / local dev state ---
*.sqlite3
*.faiss
# Derived FAISS index files (M3-A, ADR-010) — always rebuildable from PG/Mongo via
# `make rebuild-derived`; never hand-authored, so never committed. ml/eval, ml/registry
# (M3-H) are separate, tracked source trees, not covered by this.
ml/faiss/
# `make eval`'s own timestamped run reports (M3-H) — regenerated every run,
# never hand-authored; the eval *code* under ml/eval/ is tracked, its output isn't.
ml/eval/reports/
# Trained model weights (2026-07-23, skin-lesion-screener) — large (~45MB) and
# fully reproducible by re-running ml/training/ against the real, already-
# downloaded dataset (training_dataset/raw/isic-2019/); same "regenerable
# binary, never committed" treatment as ml/faiss/ above. metadata.json + the
# model's own README.md (real metrics, dataset composition, the fairness-gap
# and medical disclaimers) ARE tracked — only the weights file isn't.
ml/registry/**/*.pt
ml/registry/**/*.pth
ml/registry/**/*.onnx

# --- Generated (regenerate with `make openapi`; web/lib/api-types.ts IS committed) ---
/openapi.json

# --- Downloaded/generated datasets (training_dataset/README.md) — a local working
# directory, not a data store; the folder structure + README/MANIFEST are committed,
# real downloaded data never is. Per-dataset subfolders (sephora/, cosmetics/,
# isic-2019/) keep their own .gitkeep so the scaffold stays tracked even empty. ---
/training_dataset/raw/*
!/training_dataset/raw/.gitkeep
!/training_dataset/raw/*/
/training_dataset/raw/*/*
!/training_dataset/raw/*/.gitkeep
/training_dataset/processed/*
!/training_dataset/processed/.gitkeep

# --- Graphify (ADR-006) — now fully local, not a committed artifact.
# The graph used to be committed (graph.json/graph.html/GRAPH_REPORT.md/manifest.json
# per docs/GRAPHIFY_SETUP.md), but graph.json alone churned thousands of lines on every
# commit via the post-commit rebuild hook, which is what motivated the history rewrite
# that removed it. It is a derived artifact — regenerate it locally with `graphify .`
# instead of syncing it through git.
graphify-out/

# --- Internal agent tooling, not part of the shipped product ---
/AGENTS.md
/CLAUDE.md
/PROGRESS.md
/Skinlytics_Antigravity_Stitch_Extraction_Prompt_Pack.md
/docs/AGENT_WORKFLOW.md
/docs/Skinlytics_Stitch_UI_Prompt_Pack_v2.md
/docs/milestones/milestone_2/MASTER_PROMPT.md
/.agents/


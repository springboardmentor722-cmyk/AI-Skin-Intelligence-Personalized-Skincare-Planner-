# --- Secrets (real env files are never committed; .env.example/.development/.production are templates only) ---
.env
.env.local
.env.*.local

# --- Node / Next.js (web/) ---
node_modules/
.next/
out/
web/.next/
web/out/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Python / FastAPI (backend/, ml/) ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# --- Databases / local dev state ---
*.sqlite3
*.faiss
# Derived FAISS index files (M3-A, ADR-010) — always rebuildable from PG/Mongo via
# `make rebuild-derived`; never hand-authored, so never committed. ml/eval, ml/registry
# (M3-H) are separate, tracked source trees, not covered by this.
ml/faiss/
# `make eval`'s own timestamped run reports (M3-H) — regenerated every run,
# never hand-authored; the eval *code* under ml/eval/ is tracked, its output isn't.
ml/eval/reports/

# --- Generated (regenerate with `make openapi`; web/lib/api-types.ts IS committed) ---
/openapi.json

# --- Downloaded/generated datasets (training_dataset/README.md) — a local working
# directory, not a data store; the folder structure + README/MANIFEST are committed,
# real downloaded data never is. Per-dataset subfolders (sephora/, cosmetics/,
# isic-2019/) keep their own .gitkeep so the scaffold stays tracked even empty. ---
/training_dataset/raw/*
!/training_dataset/raw/.gitkeep
!/training_dataset/raw/*/
/training_dataset/raw/*/*
!/training_dataset/raw/*/.gitkeep
/training_dataset/processed/*
!/training_dataset/processed/.gitkeep

# --- Graphify (ADR-006) — graph.json/graph.html/GRAPH_REPORT.md/manifest.json and the
# callflow HTML are the shared, committed knowledge graph (docs/GRAPHIFY_SETUP.md: "meant
# to be committed"). cache/ (AST + stat-index cache) and converted/ (intermediate docx/pdf
# -> md conversions) are local speed-ups, regenerated by `graphify . --update`, not the
# shared artifact — never committed.
graphify-out/cache/
graphify-out/converted/
# Per-run dated snapshots + internal analysis/label-cache/signature state — the
# post-commit hook rebuilds on every commit, so committing these would grow the repo
# unboundedly; the root graph.json/graph.html/GRAPH_REPORT.md/manifest.json stay
# updated in place instead (single shared artifact, not a history of snapshots).
graphify-out/20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
graphify-out/.graphify_root
graphify-out/.graphify_analysis.json
graphify-out/.graphify_labels.json
graphify-out/.graphify_labels.json.sig

# --- Internal agent tooling, not part of the shipped product ---
/AGENTS.md
/CLAUDE.md
/PROGRESS.md
/Skinlytics_Antigravity_Stitch_Extraction_Prompt_Pack.md
/docs/AGENT_WORKFLOW.md
/docs/Skinlytics_Stitch_UI_Prompt_Pack_v2.md
/docs/milestones/milestone_2/MASTER_PROMPT.md
/.agents/

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
*.swp

# --- Logs ---
*.log
logs/

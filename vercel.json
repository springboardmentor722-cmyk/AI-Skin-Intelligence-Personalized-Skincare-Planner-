{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/auth/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/profile/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/care-team/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/assessments/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/routines/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/recommendations/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
